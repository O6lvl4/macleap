{
  "name": "macleap",
  "version": "0.0.1",
  "description": "Detect your current Mac, find equal-or-better current models, and estimate the real upgrade cost after trade-in.",
  "type": "module",
  "bin": {
    "macleap": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:arch": "depcruise --config .dependency-cruiser.cjs src",
    "check-lineup": "tsx scripts/check-lineup.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "O6lvl4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/O6lvl4/macleap.git"
  },
  "keywords": [
    "mac",
    "macbook",
    "upgrade",
    "trade-in",
    "cli"
  ],
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dependency-cruiser": "17.3.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "4.1.5"
  },
  "dependencies": {
    "cli-table3": "0.6.5",
    "commander": "14.0.3",
    "picocolors": "1.1.1",
    "yocto-spinner": "1.1.0"
  }
}
