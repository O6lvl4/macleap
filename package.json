  "description": "Detect your current Mac, find equal-or-better current models, and estimate the real upgrade cost after trade-in.",
  "type": "module",
  "bin": {
    "macleap": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
